{
  "name": "tbachert/otel-integration-tests",
  "description": "SDK-agnostic integration tests for OpenTelemetry PHP SDK configuration",
  "license": "Apache-2.0",
  "require": {
    "amphp/amp": "^3.0",
    "amphp/byte-stream": "^2.0",
    "amphp/file": "^4.0",
    "amphp/http": "^2.0",
    "amphp/http-client": "^5.0",
    "amphp/http-server": "^3.0",
    "amphp/http-server-router": "^2.0",
    "amphp/process": "^2.1",
    "amphp/socket": "^2.0",
    "ext-openssl": "*",
    "ext-zlib": "*",
    "galbar/jsonpath": "^3.0",
    "google/protobuf": "^5.0",
    "open-telemetry/api": "dev-main#b2bc26bf8bd6b2b6447b3626b2a1b5733873aa0b as 1.10.x-dev",
    "open-telemetry/context": "^1.5",
    "open-telemetry/extension-propagator-b3": "^1.2",
    "open-telemetry/gen-otlp-protobuf": "^1.10",
    "opis/closure": "^4.5",
    "php": ">=8.4",
    "phpunit/phpunit": "^13.3",
    "psr/log": "^3.0",
    "symfony/filesystem": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Nevay\\OTelTest\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false,
      "tbachert/spi": true
    }
  }
}

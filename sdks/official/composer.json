{
  "name": "tbachert/otel-test-official",
  "description": "Run the otel-test suite against open-telemetry/sdk",
  "repositories": [
    {
      "type": "path",
      "url": "../../tests",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "tbachert/otel-test-harness": "*"
  },
  "require-dev": {
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/sdk": "^1.15",
    "open-telemetry/sdk-configuration": "^0.9.0",
    "php-http/guzzle7-adapter": "^1.1"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}

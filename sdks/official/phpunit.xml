<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="defects"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         failOnPhpunitDeprecation="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="default">
            <directory>../../tests</directory>
        </testsuite>
    </testsuites>

    <!--
        Tests tagged vendor-specific pin behavior that is outside the scope of
        the official OpenTelemetry specification (tbachert/otel-sdk options,
        non-spec environment variables, or implementation-dependent timing).
        They are excluded here so that remaining failures reflect spec gaps in
        the SDK under test.
    -->
    <groups>
        <exclude>
            <group>vendor-specific</group>
        </exclude>
    </groups>
</phpunit>
